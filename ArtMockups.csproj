<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ArtMockups</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**;tools/upscayl/**" />
    <None Include="tools/upscayl/**/*" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="data/config.json;data/scenes/**/*" />
    <None Remove="data/scenes/**/*;ffmpeg.exe" />
    <None Include="data/scenes/**/*" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ffmpeg.exe" Condition="Exists('ffmpeg.exe')" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
  </ItemGroup>

</Project>
